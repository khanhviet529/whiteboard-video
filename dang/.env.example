# Copy thanh dang/.env roi dien. File .env bi gitignore - repo nay public.
# Lay key o https://developers.tiktok.com/apps
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# PHAI trung y nguyen voi Redirect URI khai o tab DESKTOP cua Login Kit.
# Tab Web tu choi ca http va ca IP; tab Desktop cho phep loopback, va do la
# ly do dung Desktop: `code` khong bao gio ra khoi may. Doi lai la PKCE,
# tool tu lo.
TIKTOK_REDIRECT_URI=http://127.0.0.1:8723/callback/
