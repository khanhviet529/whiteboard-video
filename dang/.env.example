# Copy thanh dang/.env roi dien. File .env bi gitignore - repo nay public.
# Lay key o https://developers.tiktok.com/apps
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# PHAI trung y nguyen voi Redirect URI khai trong Login Kit cua app.
# TikTok chi nhan https - khong nhan http, ke ca localhost.
# https://127.0.0.1 la lua chon an toan: browser khong ket noi duoc nen `code`
# khong di ra khoi may, ban chi copy no tu thanh dia chi.
TIKTOK_REDIRECT_URI=https://127.0.0.1:8723/callback
